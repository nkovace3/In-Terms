# Copy this file to .env and fill in real values. .env is gitignored — .env.example is not.

GOOGLE_API_KEY=
TAVILY_API_KEY=

# Matches the default credentials/db name in ../docker-compose.yml.
# If you change POSTGRES_USER/PASSWORD/DB there, update this to match.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interms

# How often the long-running scheduler ingests (local use; in production
# GitHub Actions runs `scheduler.py --once` daily instead).
INGESTION_INTERVAL_MINUTES=60

# Cost cap: max new articles per feed per run (~$0.03 each).
MAX_NEW_ARTICLES_PER_FEED=2

# Optional: USD rates for cost estimates in logs. Comment out (don't just
# blank) any of them to log usage without a $ figure. Values below are list prices as of Nov 2026 —
# Gemini 3.5 Flash-Lite standard tier (thinking tokens bill as output) and
# Tavily pay-as-you-go basic search.
LLM_INPUT_USD_PER_MTOK=0.30
LLM_OUTPUT_USD_PER_MTOK=2.50
SEARCH_USD_PER_CALL=0.008

# DEBUG / INFO / WARNING
LOG_LEVEL=INFO
